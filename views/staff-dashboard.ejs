<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Staff Console</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#0a0f1d] text-slate-100 p-6 md:p-12 font-sans">
  <div class="max-w-5xl mx-auto space-y-6">
    <div class="flex justify-between items-center bg-[#111827] border border-slate-800 p-6 rounded-3xl">
      <div>
        <span class="text-xs uppercase tracking-widest text-indigo-400 font-bold">Faculty Portal</span>
        <h1 class="text-2xl font-bold mt-1 text-white"><%= staff.name %></h1>
      </div>
      <a href="/logout" class="px-4 py-2.5 text-xs font-semibold bg-rose-500/10 border border-rose-500/20 text-rose-400 hover:bg-rose-500/20 rounded-xl">Logout</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Add Student -->
      <div class="bg-[#111827] border border-slate-800 p-6 rounded-3xl">
        <h2 class="text-base font-bold text-white mb-4">Add Student</h2>
        <form action="/staff/add-student" method="POST" class="space-y-3 text-sm">
          <input type="text" name="reg_no" placeholder="Reg No (e.g. REG102)" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
          <input type="text" name="name" placeholder="Student Name" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
          <input type="date" name="dob" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
          <input type="text" name="department" placeholder="Department (e.g. CSE)" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
          <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl text-xs">Register Student</button>
        </form>
      </div>

      <!-- Add Marks -->
      <div class="bg-[#111827] border border-slate-800 p-6 rounded-3xl">
        <h2 class="text-base font-bold text-white mb-4">Add Subject & Marks</h2>
        <form action="/staff/add-mark" method="POST" class="space-y-3 text-sm">
          <select name="reg_no" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
            <% students.forEach(s => { %>
              <option value="<%= s.reg_no %>"><%= s.name %> (<%= s.reg_no %>)</option>
            <% }) %>
          </select>
          <div class="grid grid-cols-2 gap-3">
            <input type="text" name="subject_code" placeholder="Sub Code (CS304)" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
            <input type="text" name="subject_name" placeholder="Subject Name" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
          </div>
          <div class="grid grid-cols-2 gap-3">
            <input type="number" max="30" min="0" name="internal_marks" placeholder="Internal (30)" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
            <input type="number" max="70" min="0" name="external_marks" placeholder="External (70)" required class="w-full bg-slate-950 border border-slate-800 p-3 rounded-xl text-white">
          </div>
          <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-xl text-xs">Add Mark</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>