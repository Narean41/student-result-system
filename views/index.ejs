<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Result Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#0a0f1d] flex items-center justify-center p-4 font-sans text-slate-100">
  <div class="w-full max-w-md bg-[#111827] border border-slate-800 rounded-3xl p-8 shadow-2xl">
    <div class="text-center mb-6">
      <div class="inline-flex p-3 rounded-2xl bg-indigo-600/10 text-indigo-400 mb-3 border border-indigo-500/20">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-white">Results Portal</h1>
      <p class="text-sm text-slate-400 mt-1">Select login type to continue</p>
    </div>

    <% if (error) { %>
      <div class="mb-4 p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs text-center font-medium">
        <%= error %>
      </div>
    <% } %>

    <div class="grid grid-cols-2 p-1 bg-slate-950 rounded-xl border border-slate-800 mb-6">
      <button type="button" id="studentTab" onclick="tab('student')" class="py-2.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition">Student</button>
      <button type="button" id="staffTab" onclick="tab('staff')" class="py-2.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition">Staff Admin</button>
    </div>

    <!-- Student Form -->
    <form id="studentForm" action="/auth/student" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs uppercase text-slate-400 mb-1 font-semibold">Register Number</label>
        <input type="text" name="reg_no" required placeholder="e.g. REG101" class="w-full bg-slate-950 border border-slate-800 text-white text-sm rounded-xl p-3 focus:outline-none focus:border-indigo-500">
      </div>
      <div>
        <label class="block text-xs uppercase text-slate-400 mb-1 font-semibold">Date of Birth</label>
        <input type="date" name="dob" required class="w-full bg-slate-950 border border-slate-800 text-white text-sm rounded-xl p-3 focus:outline-none focus:border-indigo-500">
      </div>
      <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl text-sm transition shadow-lg shadow-indigo-600/25">View Result</button>
      <p class="text-center text-xs text-slate-500 pt-2">Demo: <span class="text-indigo-400 font-mono">REG101</span> / <span class="text-indigo-400 font-mono">2008-01-04</span></p>
    </form>

    <!-- Staff Form -->
    <form id="staffForm" action="/auth/staff" method="POST" class="space-y-4 hidden">
      <div>
        <label class="block text-xs uppercase text-slate-400 mb-1 font-semibold">Staff Username</label>
        <input type="text" name="username" required placeholder="e.g. staff1" class="w-full bg-slate-950 border border-slate-800 text-white text-sm rounded-xl p-3 focus:outline-none focus:border-indigo-500">
      </div>
      <div>
        <label class="block text-xs uppercase text-slate-400 mb-1 font-semibold">Password</label>
        <input type="password" name="password" required placeholder="••••••••" class="w-full bg-slate-950 border border-slate-800 text-white text-sm rounded-xl p-3 focus:outline-none focus:border-indigo-500">
      </div>
      <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl text-sm transition shadow-lg shadow-indigo-600/25">Staff Access</button>
      <p class="text-center text-xs text-slate-500 pt-2">Demo: <span class="text-indigo-400 font-mono">staff1</span> / <span class="text-indigo-400 font-mono">staff123</span></p>
    </form>
  </div>

  <script>
    function tab(role) {
      const sF = document.getElementById('studentForm');
      const stF = document.getElementById('staffForm');
      const sT = document.getElementById('studentTab');
      const stT = document.getElementById('staffTab');
      if (role === 'student') {
        sF.classList.remove('hidden');
        stF.classList.add('hidden');
        sT.className = "py-2.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition";
        stT.className = "py-2.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition";
      } else {
        stF.classList.remove('hidden');
        sF.classList.add('hidden');
        stT.className = "py-2.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition";
        sT.className = "py-2.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition";
      }
    }
  </script>
</body>
</html>
